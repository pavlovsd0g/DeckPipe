{
  "manifest_version": 3,
  "name": "DeckPipe Browser Login",
  "version": "0.6.0",
  "description": "Connect your selected Deezer or SoundCloud session to the local DeckPipe app.",
  "browser_specific_settings": {"gecko": {"id": "deckpipe-auth@deckpipe.local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}},
  "permissions": ["nativeMessaging", "cookies"],
  "optional_host_permissions": ["https://www.deezer.com/*", "https://deezer.com/*", "https://soundcloud.com/*"],
  "background": {"scripts": ["helper-core.js", "background.js"]},
  "incognito": "not_allowed",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Connect to DeckPipe"
  }
}
